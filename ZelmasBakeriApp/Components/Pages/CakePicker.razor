@using Models

<div class="container">
    @foreach (var cake in Cakes)
    {
        var isSelected = Basket.Any(item => item.Item1 == cake.Id);

        <div class="row cake-row">
            <div class="col-4">
                <span class="image fit">
                    <img src="images/@cake.Image" alt="" />
                </span>
            </div>

            <div class="col-6">
                <h3 class="indented">@cake.Name</h3>
                <p class="bestill-para indented"><i>@cake.Description</i></p>
                <p class="bestill-para indented">@cake.Price kr</p>
                <button type="button"
                        class="bestill-btn indented-btn"
                        @onclick="() => OnToggle.InvokeAsync(cake)">
                    @(isSelected ? "FJERN" : "LEGG TIL")
                </button>
                <div style="height: 2rem;"></div>
                <p class="bestill-para indented">***</p>
                <div style="height: 2rem;"></div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Cake> Cakes { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyCollection<(long, string)> Basket { get; set; } = [];

    [Parameter]
    public EventCallback<Cake> OnToggle { get; set; }
}